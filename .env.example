# Clave de API de Giphy (https://developers.giphy.com)
GIPHY_API_KEY=

# Credenciales de administrador
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Puerto del servidor (por defecto 3111)
PORT=3111

# --- Bot RAG (backend chat-key-retrieval / Sky Bot) ---
BOT_ENABLED=true
# Nombre/alias con el que aparece el bot en el chat
BOT_NAME=Sky Bot
BOT_COLOR=#38bdf8
# URL del backend RAG (chat-key-retrieval). Ej: https://tu-dominio o http://servicio:8787
BOT_BASE_URL=http://127.0.0.1:8787
# Si el backend define API_KEY, ponla aquí (se envía como Bearer)
BOT_API_KEY=
# Modelo a pedir (vacío = el configurado en el backend)
BOT_MODEL=
# "mention" = responde al mencionarlo; "all" = responde a todos los mensajes
BOT_TRIGGER=mention
# Salas donde participa (vacío = todas)
BOT_ROOMS=
# Mensajes de historial que recuerda por sala
BOT_MAX_HISTORY=12
